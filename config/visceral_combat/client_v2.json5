{
	// Compress the drawn reach of very long weapons so their arcs stay readable. The drawn arc is never longer than the real hitbox, and a longer weapon always draws longer
	"visualReachEnabled": true,
	// Reach (blocks) up to which arcs are drawn at their exact real size
	"visualReachKnee": 3.5,
	// How gently reach past the knee is compressed (blocks). Smaller = stronger compression; very large = almost none
	"visualReachSoftness": 2.0,
	// Tint trails by the weapon's material
	"materialTintEnabled": true,
	// Trail colors as 'id=#RRGGBB'. The id is checked against the weapon item itself first, then against its tool material's repair items. Prefix with # for an item tag, e.g. '#minecraft:planks=#E8B070'
