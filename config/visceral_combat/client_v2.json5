	// Trail color for weapons with no matching material entry
	"defaultColor": "#C8DCFF",
	// Lowest lightness (0-1) any trail color may have; darker materials are lifted to this so trails never read as dark
	"minTrailLightness": 0.550000011920929,
	// How thin the tail of a crescent gets, as a fraction of its width at the leading edge (0 = tapers to a point)
	"crescentTailWidth": 0.15000000596046448,
	// Draw trails fullbright, glowing regardless of surroundings. Off = lit by the world like other entities, which keeps them from flashing in dark places
	"trailGlow": false,
	// When not glowing: lowest block light (0-15) a trail is lit with, so it stays readable in caves and at night
	"trailMinLight": 7,
	// How far the edge color is blended toward white (0 = the material color, 1 = pure white)
	"edgeWhiteness": 0.550000011920929,
	// Opacity of the light razor edge
	"edgeAlpha": 0.800000011920929,
	// Opacity of the saturated body
	"bodyAlpha": 0.6499999761581421,
	// Opacity of the spiked trailing wake
	"trailAlpha": 0.44999998807907104,
	// Serration teeth on each end of the body
	"serrationTeeth": 5,
	// Depth of the body's serration, as a fraction of the visible arc
	"serrationDepth": 0.07999999821186066,
	// Spikes along the trailing wake's rough edges
	"spikeCount": 7,
	// Longest wake spike, as a fraction of the visible arc (tail end) or of the blade (inner edge)
	"spikeMaxLength": 0.30000001192092896,
	// Particle-atlas sprite the trails sample, e.g. minecraft:sweep_3. Follows your resource pack
	"trailSprite": "minecraft:sweep_3",
	// Region of that sprite to sample, as fractions 'u0,v0,u1,v1'. Should be a solid, light area
	"trailSpriteWindow": "0.19,0.41,0.81,0.46"
}